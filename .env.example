# Local development defaults. Copy to `.env` and adjust.
# Never commit real credentials. Empty Authentik credentials mean the login
# route is not configured; the app still boots and the admin panel says so.

# Postgres connection string for the local development database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dasa122_net

# Origin the browser uses: CSRF checks, OAuth callback and canonical URLs.
PUBLIC_ORIGIN=http://localhost:3000

# Parsed by env.ts for compatibility; currently unused by the API.
API_ORIGIN=http://localhost:3001

# Build-time only: the web bundle bakes this origin in. Defaults to
# http://localhost:3001 in dev and https://dasa122.net in a production build;
# setting it at runtime has no effect.
# VITE_API_ORIGIN=http://localhost:3001

# Authentik OIDC issuer URL for this application.
AUTHENTIK_ISSUER=https://auth.dasa122.net/application/o/dasa122-net/

# OIDC client credentials. Leave empty to boot without a login route.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Authentik group whose members are granted admin.
AUTHENTIK_ADMIN_GROUP=dasa122.net-admin

# Absolute session lifetime in days.
SESSION_TTL_DAYS=30

# Local-only admin bypass; refused when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# Port the API listens on.
PORT=3001

# Node environment name; `production` enables production-only behaviour.
NODE_ENV=development

# GitHub fine-grained read-only PAT; empty falls back to the unauthenticated API.
GITHUB_TOKEN=

# GitHub account whose public activity is imported.
GITHUB_USERNAME=Dasa122

# Minutes between GitHub syncs.
GITHUB_SYNC_INTERVAL_MINUTES=15

# LinkedIn API credentials; all empty means manual publishing only.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Minutes between LinkedIn tier probes and syncs.
LINKEDIN_SYNC_INTERVAL_MINUTES=60

# Directory where uploaded images are written; served from /api/media/<filename>.
MEDIA_DIR=./media

# Service token for non-browser admin clients (the MCP server). Empty disables
# bearer authentication. Must match the MCP server's DASA_MCP_TOKEN.
MCP_TOKEN=
